# Make text search tools know that these "hidden" directories contain code
!/.github/

# Caches and build artifacts
__pycache__
/build
.terraform
.terraform.lock.hcl

# Per user config such as the following belongs in your global ignore file, not here
#.python-version
#.envrc


# Local virtual environment and editor state
/.venv
/.idea
/src/*.egg-info

# Written by setuptools_scm at build and install time
/src/mothersauce/_version.py

# Tracked on purpose, whatever a global ignore file says
!/.editorconfig
